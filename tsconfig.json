{
  "compilerOptions": {
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react",
    "lib": ["dom", "dom.iterable", "esnext", "WebWorker"],
    "target": "ESNext",
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "src/*": ["./src/*"]
    }
  }
}
